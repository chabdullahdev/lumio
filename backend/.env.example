# LUMIO backend (background workers) environment variables.
#
# Copy this file to `backend/.env` and fill in the values. `backend/.env` is
# never committed to git.
#
# This file uses the SERVICE-ROLE key, which bypasses Row Level Security. It is
# server side only and must never be copied into the mobile app or shared.

# Project URL, for example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Service-role (secret) key — Dashboard -> Project Settings -> API keys.
# Starts with `sb_secret_` (new format) or is a service_role JWT (legacy).
SUPABASE_SERVICE_ROLE_KEY=

# Local Ollama server. Keep it on loopback; never expose it to the internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model used for lesson generation.
OLLAMA_MODEL=qwen3.5:9b

# Abort a single generation call after this many milliseconds (default 600000).
# OLLAMA_TIMEOUT_MS=600000

# Idle sleep between worker polls in milliseconds (default 15000).
# WORKER_POLL_MS=15000

# Librarian (scripts/librarian.ts): how often it looks for new books, and how
# many books the AI may choose per round.
# LIBRARIAN_INTERVAL_MS=1800000
# LIBRARIAN_PICK=5

# Set to off to stop the AI choosing each user's next lesson topic (the built-in
# rules are used instead). Default: on.
# LUMIO_AI_PLANNER=on

# How long a failed (dead) lesson job waits before the worker retries it, in
# milliseconds. Default: 3600000 (1 hour).
# DEAD_JOB_RETRY_MS=3600000
