# LUMIO mobile app environment variables.
#
# Copy this file to `.env` in the project root and fill in the values from your
# Supabase project (Dashboard -> Project Settings -> API keys, or the
# "Connect" dialog).
#
# `.env` is never committed to git.
#
# Security: the publishable (or legacy anon) key is safe to ship inside a
# mobile app *when Row Level Security is enabled*. NEVER put the service-role
# or secret key in this file — it must stay on the server side only.

# Your project URL, for example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Publishable key (starts with sb_publishable_...) or the legacy anon key (JWT).
SUPABASE_PUBLISHABLE_KEY=
