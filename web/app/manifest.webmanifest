{
  "id": "/app/",
  "name": "LUMIO: Learn Something Real Every Day",
  "short_name": "LUMIO",
  "description": "One 15-minute lesson a day from the world's great books, chosen for you. Every idea you keep goes into your notebook.",
  "lang": "en",
  "start_url": "/app/?source=pwa",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e1116",
  "theme_color": "#54e36e",
  "categories": ["education", "books"],
  "icons": [
    { "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/app/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today's lesson", "url": "/app/#/home", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192" }] },
    { "name": "My notebook", "url": "/app/#/notebook", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192" }] }
  ]
}
